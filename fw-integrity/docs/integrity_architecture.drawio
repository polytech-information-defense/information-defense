<mxfile host="Electron" version="29.6.6"><diagram id="fwintegrity1" name="Контроль целостности"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1130" background="#F6F9FC" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=6;fillColor=#FAFCFE;strokeColor=#B8C5D5;strokeWidth=2;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="60" width="1960" height="1045" as="geometry"/></mxCell><mxCell id="cInt" value="" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#BD8B2A;strokeWidth=1.8;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="1220" height="695" as="geometry"/></mxCell><mxCell id="hInt" value="04  ПОДСИСТЕМА КОНТРОЛЯ ЦЕЛОСТНОСТИ  ·  процесс fw-integrity (root)" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=50;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=19;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="355" y="120" width="1190" height="49" as="geometry"/></mxCell><mxCell id="sub" value="Python 3.13, только стандартная библиотека. Один процесс asyncio; хеширование выполняется в отдельном потоке" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=12;fontColor=#183247;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="172" width="1180" height="26" as="geometry"/></mxCell><mxCell id="cData" value="" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=6;fillColor=#FFFFFF;strokeColor=#91A2B4;strokeWidth=1.8;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="880" width="1220" height="205" as="geometry"/></mxCell><mxCell id="hData" value="ПОСТОЯННЫЕ ДАННЫЕ" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#EEF3F8;strokeColor=#91A2B4;strokeWidth=1.5;fontSize=19;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="355" y="1035" width="1190" height="37" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API-сервер&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;/run/fw/integrity.sock · JSON-строки (АПИ-03/04)&lt;br&gt;Проверка прав по ctx: ТЧ / ЧЗ / подсистема&lt;br&gt;Отказ → событие 106&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=17;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="215" width="520" height="115" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b&gt;Планировщик проверок (ЦЛС-03)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;При запуске (до READY=1)&lt;br&gt;Каждые 1–1440 мин, по умолчанию 10&lt;br&gt;По запросу администратора&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=17;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="215" width="520" height="115" as="geometry"/></mxCell><mxCell id="core" value="&lt;b&gt;Ядро подсистемы&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;Режимы: обычный / аварийный (state.json)&lt;br&gt;Легитимные изменения: begin_update → commit_update&lt;br&gt;Параметры: период проверки (событие 416)&lt;br&gt;Одна блокировка на проверку, восстановление и обновление эталонов&lt;br&gt;Нарушение → аварийный режим (ЦЛС-04, ЦЛС-07)&lt;br&gt;Успешная повторная проверка → выход (ЦЛС-06)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="375" width="580" height="225" as="geometry"/></mxCell><mxCell id="block" value="&lt;b&gt;Глобальная блокировка трафика&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;1) set_emergency → фильтрация&lt;br&gt;2) остановка fw-filter, fw-web, ssh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="375" width="460" height="105" as="geometry"/></mxCell><mxCell id="events" value="&lt;b&gt;Отправка событий&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;Коды 416, 500–505; очередь до 1000;&lt;br&gt;дублирование в journald&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="505" width="460" height="95" as="geometry"/></mxCell><mxCell id="chk" value="&lt;b&gt;Проверка файлов (ЦЛС-01)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;SHA-256 и сравнение с эталоном&lt;br&gt;Изменён · удалён · посторонний · не читается&lt;br&gt;Файлы в процессе изменения пропускаются&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=17;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="650" width="420" height="140" as="geometry"/></mxCell><mxCell id="rest" value="&lt;b&gt;Восстановление (ЦЛС-05)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;Копия проверяется по эталону&lt;br&gt;Изменённый файл ← копия&lt;br&gt;Посторонний файл → карантин&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=17;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="650" width="320" height="140" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;Проверка ОС (ОБР-02)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;ip_forward, IPv6, адреса портов&lt;br&gt;promisc, MTU, мосты, VLAN&lt;br&gt;offload (ethtool), drop на ingress&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#FFF5DE;strokeColor=#BD8B2A;strokeWidth=1.5;fontSize=17;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="650" width="320" height="140" as="geometry"/></mxCell><mxCell id="man" value="&lt;b&gt;Манифест и настройки&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;manifest.json: static / config&lt;br&gt;integrity.json&lt;br&gt;(сами контролируются)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#EEF3F8;strokeColor=#91A2B4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="900" width="260" height="115" as="geometry"/></mxCell><mxCell id="files" value="&lt;b&gt;Контролируемые файлы&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;static: код /usr/lib/fw/**, юниты&lt;br&gt;config: startup.conf, policy.json,&lt;br&gt;system.json, accounts.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#EEF3F8;strokeColor=#91A2B4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="900" width="340" height="115" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;Хранилище /var/lib/fw/integrity (только root)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;reference.json — эталоны SHA-256 · backup/&amp;lt;sha256&amp;gt; — копии&lt;br&gt;quarantine/ — посторонние файлы&lt;br&gt;state.json — режим, нарушения, период, boot_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#EEF3F8;strokeColor=#91A2B4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="900" width="520" height="115" as="geometry"/></mxCell><mxCell id="mgmt" value="&lt;b&gt;02 Подсистема управления&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;CLI (консоль, SSH), web&lt;br&gt;Функции 29, 30; в аварийном&lt;br&gt;режиме — только консоль&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#E9F1FD;strokeColor=#4D79B8;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="230" height="140" as="geometry"/></mxCell><mxCell id="own" value="&lt;b&gt;Владельцы конфигураций&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;Фильтрация: policy.json&lt;br&gt;Управление: startup.conf,&lt;br&gt;accounts.json, system.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#EEF0FC;strokeColor=#7373BD;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="230" height="140" as="geometry"/></mxCell><mxCell id="filt" value="&lt;b&gt;01 Подсистема фильтрации&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;Все кадры удаляются,&lt;br&gt;пока включена блокировка&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#E5F7F9;strokeColor=#2C8A9D;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="290" width="320" height="95" as="geometry"/></mxCell><mxCell id="sysd" value="&lt;b&gt;ОС Linux / systemd&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;Type=notify: READY=1 после проверки&lt;br&gt;Запуск и остановка служб&lt;br&gt;gate в ExecStartPre fw-filter, fw-web&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#EEF3F8;strokeColor=#91A2B4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="410" width="320" height="140" as="geometry"/></mxCell><mxCell id="log" value="&lt;b&gt;03 Подсистема регистрации&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;Журнал событий&lt;br&gt;(команда log_event)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#E9F7EF;strokeColor=#3C9576;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="575" width="320" height="95" as="geometry"/></mxCell><mxCell id="oscfg" value="&lt;b&gt;Настройки ОС&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#516378&quot; style=&quot;font-size:13px&quot;&gt;/proc/sys, /sys/class/net&lt;br&gt;ip -j, ethtool -k, nft -j&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#193041;fontFamily=Arial;spacing=11;shadow=0;glass=0;arcSize=12;fillColor=#EEF3F8;strokeColor=#91A2B4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="695" width="320" height="115" as="geometry"/></mxCell><mxCell id="e1" value="команды&lt;br&gt;администратора" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4D79B8;strokeWidth=2.6;endArrow=block;endFill=1;exitX=1;exitY=0.354;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=10;fontSize=12;fontColor=#183247;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mgmt" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="begin / commit&lt;br&gt;_update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7373BD;strokeWidth=2.4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=10;fontSize=12;fontColor=#183247;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="own" target="api"><mxGeometry relative="1" as="geometry" x="-0.6"><Array as="points"><mxPoint x="320" y="450"/><mxPoint x="320" y="301"/></Array></mxGeometry></mxCell><mxCell id="e3" value="команды" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BD8B2A;strokeWidth=2.6;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.448;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=10;fontSize=12;fontColor=#183247;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="запуск проверки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BD8B2A;strokeWidth=2.6;endArrow=block;endFill=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=10;fontSize=12;fontColor=#183247;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sched" target="core"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1052" y="352"/><mxPoint x="902" y="352"/></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BD8B2A;strokeWidth=2.6;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=10;fontSize=12;fontColor=#183247;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="core" target="block"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BD8B2A;strokeWidth=2.2;endArrow=block;endFill=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=10;fontSize=12;fontColor=#183247;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="core" target="events"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BD8B2A;strokeWidth=2.2;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.414;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=10;fontSize=12;fontColor=#183247;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="core" target="chk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BD8B2A;st